import 'dart:math' as math;
import 'package:flutter/material.dart';

class RiceCinematic extends StatefulWidget {
  const RiceCinematic({super.key});

  @override
  State<RiceCinematic> createState() => _RiceCinematicState();
}

class _RiceCinematicState extends State<RiceCinematic>
    with SingleTickerProviderStateMixin {
  late final AnimationController controller;

  @override
  void initState() {
    super.initState();
    controller = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 4200),
    )..repeat(reverse: true);
  }

  @override
  void dispose() {
    controller.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: controller,
      builder: (_, __) {
        return CustomPaint(
          painter: _RicePainter(controller.value),
          size: Size.infinite,
        );
      },
    );
  }
}

class _RicePainter extends CustomPainter {
  final double t;
  _RicePainter(this.t);

  @override
  void paint(Canvas canvas, Size size) {
    final w = size.width;
    final h = size.height;

    canvas.save();
    canvas.translate(w / 2, h * 0.55);
    canvas.scale(0.85 + 0.12 * math.sin(t * math.pi));

    final glow = Paint()
      ..color = const Color(0x5538D98A)
      ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 35);

    canvas.drawCircle(Offset.zero, 85, glow);

    final stemPaint = Paint()
      ..color = const Color(0xFF5BBD67)
      ..strokeWidth = 4
      ..strokeCap = StrokeCap.round
      ..style = PaintingStyle.stroke;

    final leafPaint = Paint()
      ..color = const Color(0xFF78D957)
      ..strokeWidth = 3
      ..strokeCap = StrokeCap.round
      ..style = PaintingStyle.stroke;

    final grainPaint = Paint()
      ..color = const Color(0xFFFFD66B)
      ..style = PaintingStyle.fill;

    final sway = math.sin(t * math.pi * 2) * 9;

    final stem = Path()
      ..moveTo(0, 90)
      ..cubicTo(-5, 20, sway, -45, sway + 8, -125);

    canvas.drawPath(stem, stemPaint);

    final leftLeaf = Path()
      ..moveTo(-2, 40)
      ..quadraticBezierTo(-45, 5, -75, -15);

    final rightLeaf = Path()
      ..moveTo(0, 10)
      ..quadraticBezierTo(45, -30, 72, -48);

    canvas.drawPath(leftLeaf, leafPaint);
    canvas.drawPath(rightLeaf, leafPaint);

    final headX = sway + 8;
    final headY = -125.0;

    final panicle = Path()
      ..moveTo(headX, headY)
      ..quadraticBezierTo(headX + 28, headY - 35, headX + 40, headY - 65);

    canvas.drawPath(panicle, stemPaint);

    for (int i = 0; i < 12; i++) {
      final progress = i / 12;
      final x = headX + 8 + progress * 35;
      final y = headY - 10 - progress * 48;

      canvas.save();
      canvas.translate(x, y);
      canvas.rotate(-0.45 + progress * 0.5);

      final grain = RRect.fromRectAndRadius(
        Rect.fromCenter(
          center: Offset.zero,
          width: 7,
          height: 15,
        ),
        const Radius.circular(5),
      );

      canvas.drawRRect(grain, grainPaint);
      canvas.restore();
    }

    for (int i = 0; i < 16; i++) {
      final angle = t * math.pi * 2 + i * math.pi / 8;
      final radius = 95 + 12 * math.sin(angle * 2);
      final x = math.cos(angle) * radius;
      final y = math.sin(angle) * radius - 30;

      final particlePaint = Paint()
        ..color = Color.lerp(
          const Color(0xFF6CE6A0),
          const Color(0xFFFFD66B),
          (i % 4) / 3,
        )!
        ..style = PaintingStyle.fill;

      canvas.drawCircle(Offset(x, y), 2.2, particlePaint);
    }

    canvas.restore();
  }

  @override
  bool shouldRepaint(covariant _RicePainter oldDelegate) =>
      oldDelegate.t != t;
}
